void main()
{
    int a = 2 + 3 * 4;
    int b = (2 + 3) * 4;

    boolean less = 10 < 20;
    boolean equal = 10 == 10;
    boolean logic = true && !false;

    print("2 + 3 * 4 = ", a);
    print("(2 + 3) * 4 = ", b);
    print("10 < 20: ", less);
    print("10 == 10: ", equal);
    print("true && !false: ", logic);
}
