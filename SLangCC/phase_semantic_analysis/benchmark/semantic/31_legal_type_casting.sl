void main() {
    int integerValue = 65;
    double doubleValue = 2.5;
    character characterValue = 'A';
    boolean booleanValue = true;

    double integerAsDouble = (double)integerValue;
    character integerAsCharacter = (character)integerValue;
    int characterAsInteger = (int)characterValue;
    string characterAsString = (string)characterValue;
    string integerAsString = (string)integerValue;
    string doubleAsString = (string)doubleValue;
    string booleanAsString = (string)booleanValue;
}
