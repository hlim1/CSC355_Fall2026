void main() {
    int intValue = 65;
    double doubleValue = 4.5;
    boolean booleanValue = true;
    character characterValue = 'A';
    string stringValue = "hello";

    boolean intToBoolean = (boolean)intValue;

    int doubleToInt = (int)doubleValue;
    boolean doubleToBoolean = (boolean)doubleValue;
    character doubleToCharacter = (character)doubleValue;

    int booleanToInt = (int)booleanValue;
    double booleanToDouble = (double)booleanValue;
    character booleanToCharacter = (character)booleanValue;

    double characterToDouble = (double)characterValue;
    boolean characterToBoolean = (boolean)characterValue;

    int stringToInt = (int)stringValue;
    double stringToDouble = (double)stringValue;
    boolean stringToBoolean = (boolean)stringValue;
    character stringToCharacter = (character)stringValue;
}
